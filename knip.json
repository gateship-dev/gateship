{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "webui/src/main.tsx",
    "webui/src/design.tsx",
    "webui/src/design/harness-hook.ts",
    "webui/vite.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "webui/**/*.{ts,tsx}",
    "webui/**/*.css"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": ["exports", "types", "duplicates"]
}
