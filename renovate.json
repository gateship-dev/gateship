{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Auto-merge bun-version pin (.bun-version) on any update type; automerge stays gated on the required CI status check.",
      "matchManagers": ["bun-version"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": "Auto-merge asdf tool pins (.tool-versions) on any update type; automerge stays gated on the required CI status check.",
      "matchManagers": ["asdf"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": "Auto-merge GitHub Actions workflow pins on any update type; automerge stays gated on the required CI status check.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": "Check provider CLI pins daily and group them in one non-automatic PR.",
      "matchDatasources": ["github-releases", "npm"],
      "matchPackageNames": ["anthropics/claude-code", "@openai/codex"],
      "schedule": ["every day"],
      "prConcurrentLimit": 1,
      "prHourlyLimit": 1,
      "automerge": false,
      "groupName": "provider CLI versions",
      "groupSlug": "provider-cli-versions",
      "rangeStrategy": "pin"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^provider-cli-versions\\.json$/"],
      "matchStrings": ["\\\"claudeCode\\\"\\s*:\\s*\\\"(?<currentValue>[^\\\"]+)\\\""],
      "depNameTemplate": "anthropics/claude-code",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^provider-cli-versions\\.json$/"],
      "matchStrings": ["\\\"codexCli\\\"\\s*:\\s*\\\"(?<currentValue>[^\\\"]+)\\\""],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
